DB_SERVER=(localdb)\MSSQLLocalDB
DB_NAME=GatePassDB
DB_DRIVER=ODBC Driver 17 for SQL Server
# Required, 32+ random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DEFAULT_ADMIN_USERNAME=admin
# Only used when the users table is empty; must not be the old ChangeMe123! placeholder
DEFAULT_ADMIN_PASSWORD=
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false

# ---- Site settings ----
SITE_TIMEZONE=Asia/Kolkata
DWELL_SLA_MINUTES=120
QUALITY_SLA_MINUTES=60

# ---- OCR (none = manual entry only, mock = sample values, http = real service) ----
OCR_PROVIDER=none
OCR_BASE_URL=
OCR_API_KEY=
OCR_TIMEOUT_SECONDS=15
OCR_CONFIDENCE_THRESHOLD=85

# ---- PO lookup in the ERP (none = not checked, mock = fixture POs, http = live) ----
PO_LOOKUP_PROVIDER=none
FARVISION_READ_URL=
FARVISION_READ_KEY=
PO_LOOKUP_TIMEOUT_SECONDS=10
ERP_TENANT_ID=75

# ---- Weighbridge indicator (none = manual entry only, mock = random readings, http = live) ----
WEIGHBRIDGE_PROVIDER=none
WEIGHBRIDGE_URL=
WEIGHBRIDGE_KEY=
WEIGHBRIDGE_TIMEOUT_SECONDS=5

# ---- GRN write to the ERP (mock = local fake GRN numbers, http = live) ----
GRN_WRITE_PROVIDER=mock
FARVISION_WRITE_URL=
FARVISION_WRITE_KEY=
ERP_INSTANCE=VJ
GRN_WRITE_TIMEOUT_SECONDS=20
# true makes every mock post fail, to test the retry flow
GRN_MOCK_FAIL=false
GRN_RETRY_MIN_INTERVAL_MINUTES=10
GRN_MAX_AUTO_ATTEMPTS=10

# ---- Quality app inbound (empty = integration disabled) ----
# Shared secret the Quality app sends in the X-Service-Key header; 32+ random chars.
QUALITY_INBOUND_SECRET=
